{
  "name": "hiranix-website",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 80",
    "edge >= 80",
    "firefox >= 78",
    "safari >= 13.1",
    "ios_saf >= 13.4"
  ],
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:next": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint",
    "check:nav": "node scripts/check-navigation.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "^16.2.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "^5",
    "vinext": "0.0.50",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
