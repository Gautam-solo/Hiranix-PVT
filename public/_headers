# Headers for static files served straight from Cloudflare (pages themselves
# get their headers from next.config.ts). This file replaces the one vinext
# would generate, so the long-lived caching of hashed build files is kept here.

# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
